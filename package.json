{
  "name": "amni-connect",
  "version": "1.5.13",
  "description": "End-to-end encrypted Rust + Electron remote desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "build": "node scripts/make-icon.js && electron-builder",
    "dist": "node scripts/make-icon.js && electron-builder --win nsis",
    "dist:linux": "node scripts/make-icon.js && electron-builder --linux AppImage deb rpm",
    "dist:all": "node scripts/make-icon.js && electron-builder --win nsis --linux AppImage deb rpm",
    "release": "node scripts/make-icon.js && electron-builder --win nsis --publish always",
    "release:linux": "node scripts/make-icon.js && electron-builder --linux AppImage deb rpm --publish always",
    "dev": "nodemon server.js",
    "server": "node server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.7"
  },
  "build": {
    "appId": "com.amni.connect",
    "productName": "Amni-Connect",
    "executableName": "amni-connect",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!rust/target/**",
      "!backups/**",
      "!docs/**",
      "!dist/**",
      "!build/*.exe",
      "!build/amni-control"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "build/amni-control.exe",
          "to": "amni-control.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "shortcutName": "Amni-Connect",
      "runAfterFinish": true,
      "include": "scripts/installer.nsh",
      "artifactName": "Amni-Connect-Setup-${version}.${ext}",
      "uninstallDisplayName": "Amni-Connect"
    },
    "mac": {
      "target": "dmg",
      "extraResources": [
        {
          "from": "build/amni-control",
          "to": "amni-control"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "maintainer": "Amnibro <amnibro7@gmail.com>",
      "vendor": "Amniscient, LLC",
      "synopsis": "E2EE peer-to-peer remote desktop",
      "description": "End-to-end encrypted remote desktop over WebRTC. One install starts the host UI, embedded signaling, and Rust input daemon.",
      "artifactName": "Amni-Connect-${version}.${ext}",
      "executableName": "amni-connect",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "Amni-Connect",
        "Comment": "End-to-end encrypted remote desktop",
        "Categories": "Network;RemoteAccess;",
        "StartupWMClass": "amni-connect"
      },
      "extraResources": [
        {
          "from": "build/amni-control",
          "to": "amni-control"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libxdo3 | libxdo4",
        "libxkbcommon0"
      ]
    },
    "rpm": {
      "depends": [
        "libXtst",
        "libxkbcommon",
        "libxdo"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Amnibro",
        "repo": "Amni-Connect",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "remote-desktop",
    "webrtc",
    "rust",
    "e2ee",
    "electron"
  ],
  "author": "Amnibro (Amni-Scient) <amnibro7@gmail.com>",
  "homepage": "https://amni-scient.com/amni-connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amnibro/Amni-Connect.git"
  },
  "license": "SEE LICENSE IN LICENSE"
}
